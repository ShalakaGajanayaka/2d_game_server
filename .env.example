# ========================================================
# SkyRush 2D Game Server - Environment Configuration Template
# COPY THIS FILE TO .env AND FILL IN YOUR SECRETS
# NEVER COMMIT .env TO VERSION CONTROL!
# ========================================================

PORT=3000
NODE_ENV=development

# Redis Caching & Distributed Locks
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_TLS=false

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secure_database_password
DB_NAME=skyrush_db

# Admin Panel Authentication
# Choose a strong admin username and high-entropy password (min 16 chars)
ADMIN_USERNAME=admin@skyrush.cc
ADMIN_PASSWORD=change_this_to_a_secure_random_password
ADMIN_JWT_SECRET=generate_with_openssl_rand_hex_32

# Resend Transactional Email API (https://resend.com)
# Get a production API key from Resend console
RESEND_API_KEY=re_your_secret_resend_api_key
EMAIL_FROM="SkyRush Security <noreply@skyrush.cc>"
